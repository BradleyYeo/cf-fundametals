{
    "$schema": "node_modules/wrangler/config-schema.json",
    "assets": {
        "binding": "ASSETS",
        "directory": "dist/client",
        "not_found_handling": "none"
    },
    "cache": {
        "enabled": true
    },
    "compatibility_date": "2026-08-11",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "d1_databases": [
        {
            "binding": "VIEWS_DB",
            "database_id": "6b074eae-5bb3-4d88-ba22-282c482b96b1",
            "database_name": "portfolio-views"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "VINEXT_KV_CACHE",
            "id": "2f6441c9b2ce488197447b3fab33a90f"
        }
    ],
    "main": "vinext/server/fetch-handler",
    "name": "portfolio",
    "routes": [
        {
            "pattern": "bradleyyeo.com",
            "custom_domain": true
        }
    ],
    "secrets_store_secrets": [
        {
            "binding": "TURNSTILE_SECRET_KEY",
            "secret_name": "turnstile-secret-key",
            "store_id": "1cf115b4569f48c088f6780aa2f6a466"
        }
    ]
}